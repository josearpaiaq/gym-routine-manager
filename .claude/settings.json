{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm run test:coverage 2>&1 | tail -30",
            "asyncRewake": true,
            "timeout": 120,
            "statusMessage": "Checking coverage thresholds..."
          }
        ]
      }
    ]
  }
}
